#version 450
#extension GL_GOOGLE_include_directive : require
// FSR 1 RCAS after ndsr_easu.comp (DM_VK_NDSR_SHARP): sharpens the replay's intermediate image into the game's output image, one pixel per invocation
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(set = 0, binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst;
layout(push_constant) uniform P { uvec4 con0, con1, con2, con3; uvec2 size; } pc;
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
// Clamped: RCAS reads a 3x3 neighbourhood, and the replay leaves robustness off, so the edge pixels must not read outside the image
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(tex, clamp(p, ASU2(0), textureSize(tex, 0) - 1), 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, pc.size))) return;
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, p, pc.con0);
    imageStore(dst, ivec2(p), vec4(c, 1.0));
}
