#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=32) in;
layout(triangles,max_vertices=3,max_primitives=1) out;
out gl_MeshPerVertexEXT { vec4 gl_Position; float gl_PointSize; } gl_MeshVerticesEXT[];
taskPayloadSharedEXT uint payload[64];
layout(location=0) perprimitiveEXT out vec4 attr[];
void main() {
 SetMeshOutputsEXT(3u,1u);
 uint i=gl_LocalInvocationIndex;
 if(i<3u) gl_MeshVerticesEXT[i].gl_Position=vec4(float(payload[i]),float(gl_WorkGroupID.x),float(i),1.0);
 if(i==0u) { gl_PrimitiveTriangleIndicesEXT[0]=uvec3(0,1,2); float x=float(payload[63]); float rounded=x*1.0000001192092896; attr[0]=vec4(x,rounded-x,3,4); }
}
