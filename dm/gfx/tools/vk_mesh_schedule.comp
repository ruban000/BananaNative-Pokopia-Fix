#version 450

// The host only runs this after proving that the task grid fits the output
// arena. Task records are in guest order; preserve it in the mesh and draw.
layout(local_size_x = 1) in;
layout(set = 0, binding = 1, std430) readonly buffer Tasks { uint w[]; } task;
layout(set = 0, binding = 2, std430) writeonly buffer Map { uint w[]; } map;
layout(set = 0, binding = 3, std430) readonly buffer Control { uint w[]; } ctl;

void main() {
    uint total = 0u;
    bool valid = true;
    for (uint t = 0u; t < ctl.w[6]; ++t) {
        uint h = t * ctl.w[1];
        uint n = task.w[h];
        if (task.w[h + 1u] != 1u || task.w[h + 2u] != 1u || n > ctl.w[7] - total) {
            valid = false;
            break;
        }
        for (uint x = 0u; x < n; ++x) {
            uint p = (ctl.w[2] + total + x) * 4u;
            map.w[p] = t;
            map.w[p + 1u] = x;
            map.w[p + 2u] = 0u;
            map.w[p + 3u] = 0u;
        }
        total += n;
    }
    if (!valid) total = 0u;
    map.w[0] = total;
    map.w[1] = 1u;
    map.w[2] = 1u;
    map.w[3] = valid ? 0u : 1u;
    map.w[4] = total * ctl.w[3];
    map.w[5] = 1u;
    map.w[6] = 0u;
    map.w[7] = 0u;
}
